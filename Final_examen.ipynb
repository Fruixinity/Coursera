# 1. Import des bibliothèques nécessaires
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns

# 2. Chargement des données
URL = "https://cf-courses-data.s3.us.cloud-object-storage.appdomain.cloud/IBMDeveloperSkillsNetwork-DA0101EN-SkillsNetwork/labs/Datafiles/historical_automobile_sales.csv"
df = pd.read_csv(URL)

# ---------------------------------------------------------
# TASK 1.1: Line chart showing Automobile sales fluctuation
# ---------------------------------------------------------
df_line = df.groupby("Year")["Automobile_Sales"].mean().reset_index()
plt.figure(figsize=(10, 6))
plt.plot(df_line["Year"], df_line["Automobile_Sales"], marker="o")
plt.title("Automobile Sales Fluctuation Over Years")
plt.xlabel("Year")
plt.ylabel("Average Automobile Sales")
plt.grid(True)
plt.show()

# ---------------------------------------------------------
# TASK 1.2: Line chart by vehicle type during recession vs non-recession
# ---------------------------------------------------------
df_Mline = (
    df.groupby(["Year", "Vehicle_Type"])["Automobile_Sales"].mean().reset_index()
)
plt.figure(figsize=(10, 6))
sns.lineplot(
    data=df_Mline, x="Year", y="Automobile_Sales", hue="Vehicle_Type"
)
plt.title("Sales Trend per Vehicle Type Over Years")
plt.xlabel("Year")
plt.ylabel("Average Automobile Sales")
plt.show()

# ---------------------------------------------------------
# TASK 1.3: Grouped bar plot of sales by vehicle type in recession/non-recession
# ---------------------------------------------------------
plt.figure(figsize=(10, 6))
sns.barplot(
    x="Recession", y="Automobile_Sales", hue="Vehicle_Type", data=df
)
plt.title(
    "Average Automobile Sales by Vehicle Type during Recession and Non-Recession"
)
plt.xlabel("Economic Condition (0: Non-Recession, 1: Recession)")
plt.ylabel("Average Automobile Sales")
plt.show()

# ---------------------------------------------------------
# TASK 1.4: Subplots for GDP comparison (Recession vs Non-Recession)
# ---------------------------------------------------------
rec_data = df[df["Recession"] == 1]
non_rec_data = df[df["Recession"] == 0]

fig, (ax0, ax1) = plt.subplots(1, 2, figsize=(12, 6))

sns.lineplot(
    x="Year", y="GDP", data=rec_data, ax=ax0, label="Recession GDP"
)
ax0.set_title("GDP Variation during Recession Period")
ax0.set_xlabel("Year")
ax0.set_ylabel("GDP")

sns.lineplot(
    x="Year", y="GDP", data=non_rec_data, ax=ax1, label="Non-Recession GDP"
)
ax1.set_title("GDP Variation during Non-Recession Period")
ax1.set_xlabel("Year")
ax1.set_ylabel("GDP")

plt.tight_layout()
plt.show()

# ---------------------------------------------------------
# TASK 1.5: Bubble plot for Impact of Seasonality on Automobile Sales
# ---------------------------------------------------------
plt.figure(figsize=(10, 6))
sns.scatterplot(
    data=df,
    x="Month",
    y="Automobile_Sales",
    size="Seasonality_Weight",
    hue="Seasonality_Weight",
    sizes=(20, 200),
)
plt.title("Seasonality Impact on Automobile Sales")
plt.xlabel("Month")
plt.ylabel("Automobile Sales")
plt.show()

# ---------------------------------------------------------
# TASK 1.6: Scatter plot for Consumer Confidence vs Sales during Recession
# ---------------------------------------------------------
plt.figure(figsize=(10, 6))
sns.scatterplot(
    data=rec_data, x="Consumer_Confidence", y="Automobile_Sales"
)
plt.title("Consumer Confidence vs. Automobile Sales during Recessions")
plt.xlabel("Consumer Confidence")
plt.ylabel("Automobile Sales")
plt.show()

# ---------------------------------------------------------
# TASK 1.7: Pie chart for Advertising Expenditure share
# ---------------------------------------------------------
Rdata = df[df["Recession"] == 1]
NRdata = df[df["Recession"] == 0]

Rexp = Rdata.groupby("Vehicle_Type")["Advertising_Expenditure"].sum()
NRexp = NRdata.groupby("Vehicle_Type")["Advertising_Expenditure"].sum()

fig, (ax0, ax1) = plt.subplots(1, 2, figsize=(12, 6))

Rexp.plot(
    kind="pie",
    autopct="%1.1f%%",
    ax=ax0,
    startangle=90,
    title="Advertising Expenditure during Recession",
)
NRexp.plot(
    kind="pie",
    autopct="%1.1f%%",
    ax=ax1,
    startangle=90,
    title="Advertising Expenditure during Non-Recession",
)

plt.show()

# ---------------------------------------------------------
# TASK 1.8: Pie chart for Advertisement Expenditure per vehicle type in Recession
# ---------------------------------------------------------
plt.figure(figsize=(8, 8))
Rexp.plot(
    kind="pie",
    autopct="%1.1f%%",
    startangle=90,
    shadow=True,
    title="Total Advertising Expenditure by Vehicle Type during Recession",
)
plt.ylabel("")
plt.show()

# ---------------------------------------------------------
# TASK 1.9: Line plot for Unemployment Rate vs Sales by Vehicle Type
# ---------------------------------------------------------
plt.figure(figsize=(10, 6))
sns.lineplot(
    data=rec_data,
    x="unemployment_rate",
    y="Automobile_Sales",
    hue="Vehicle_Type",
    ci=None,
)
plt.title("Effect of Unemployment Rate on Vehicle Type Sales during Recession")
plt.xlabel("Unemployment Rate")
plt.ylabel("Automobile Sales")
plt.show()